{
  "manifest_version": 3,
  "name": "Summit Block – Ad & Tracker Blocker",
  "short_name": "Summit Block",
  "version": "1.0.0",
  "description": "Fast, private, open-source ad and tracker blocker. Blocks ads, trackers, malware domains and annoying page elements. Zero data collection.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Summit Block",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/cosmetic.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "src/rules/ads.json" },
      { "id": "trackers", "enabled": true, "path": "src/rules/trackers.json" },
      { "id": "malware", "enabled": true, "path": "src/rules/malware.json" }
    ]
  }
}
